# Environment configuration template for BABY AI Operating System
# Copy this file to .env and populate secret values.
# NEVER commit the actual .env file or real secrets to source control.

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# Model Provider Configuration
# ==============================================================================
# Supply your API key in .env (never commit secrets)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # Optional: override for local / NVIDIA endpoints
# ANTHROPIC_API_KEY=sk-ant-...

# Default model used by planning and specialist agents
DEFAULT_MODEL=gpt-4

# ==============================================================================
# API Authentication & Authorization
# ==============================================================================
# Enforce authentication for all API endpoints. Keep this true for every deployment.
API_REQUIRE_AUTH=true

# Explicit local development mode. API_REQUIRE_AUTH=false is rejected at startup unless
# DEVELOPMENT_MODE=true is also set; that combination gives EVERY caller admin access, so use
# it only on a local machine with the API bound to 127.0.0.1. Never enable it in production.
DEVELOPMENT_MODE=false

# API bearer tokens. These ship EMPTY on purpose: generate a unique secret for each one.
# Requirements (enforced at startup; invalid values refuse to start):
#   - at least 32 characters, no surrounding whitespace
#   - not a placeholder (values containing e.g. "change-me" / "placeholder" are rejected)
#   - operator and admin tokens must be different
# Generate each token separately with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Leaving both empty with API_REQUIRE_AUTH=true keeps the API locked (every request gets 401).

# Operator token (task submission, task read, worker status)
API_AUTH_TOKEN=

# Administrator token (required for approval decisions: approve/deny)
API_ADMIN_TOKEN=

# Comma-separated list of engagement IDs the operator token is authorized to access
# Example: "default,engagement-alpha,engagement-beta"
# Empty string defaults to "default" scope
OPERATOR_ENGAGEMENTS=default

# ==============================================================================
# Database & Persistence Configuration
# ==============================================================================
# SQLite connection string. Default is ./baby.db with WAL mode enabled.
DATABASE_URL=sqlite:///./baby.db

# Storage backends: "sqlite" (durable, recommended) or "in_memory" (testing only)
PERSISTENCE_BACKEND=sqlite
MEMORY_STORAGE_TYPE=sqlite
AUDIT_STORAGE_TYPE=sqlite

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info

# ==============================================================================
# Security & Approvals
# ==============================================================================
ENABLE_APPROVAL_WORKFLOW=true

# ==============================================================================
# Durable Worker Processes (baby.workers)
# ==============================================================================
# Set WORKER_ENABLED=true to let the API process supervise worker processes automatically,
# or leave false and run `python -m baby.workers run` as a standalone service.
WORKER_ENABLED=false
WORKER_COUNT=1
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
WORKER_STALE_TIMEOUT_SECONDS=30.0
TASK_LEASE_DURATION_SECONDS=60.0
WORKER_SHUTDOWN_GRACE_SECONDS=10.0
WORKER_MAX_TASK_SECONDS=3600

# ==============================================================================
# Coding Subsystem Safeguards
# ==============================================================================
# Directory the CodingAgent may read (and, with admin approval, write). Required by the
# default worker bootstrap: workers refuse to start if it is unset, missing, not a directory,
# or contains Baby's database (DATABASE_URL) or this .env file. Point it at a separate project.
# CODING_REPO_ROOT=../my-project
CODING_MAX_FILE_SIZE_BYTES=1048576
CODING_MAX_LIST_ENTRIES=1000
CODING_MAX_LIST_DEPTH=20
CODING_MAX_ITERATIONS=10
CODING_MAX_TOOL_CALLS_PER_ITERATION=5
CODING_MAX_TOOL_RETRIES=3
