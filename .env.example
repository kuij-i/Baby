# Environment configuration for BABY

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Model provider configuration
# OPENAI_API_KEY is intentionally NOT here - use .env (not committed)
# ANTHROPIC_API_KEY is intentionally NOT here - use .env (not committed)

# Default model for agents (can be overridden per agent)
DEFAULT_MODEL=gpt-4

# Database configuration
DATABASE_URL=sqlite:///./baby.db

# Memory storage (can be extended to support other backends)
MEMORY_STORAGE_TYPE=sqlite

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info

# Security
ENABLE_APPROVAL_WORKFLOW=true
