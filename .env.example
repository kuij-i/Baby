# Environment configuration for BABY

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Model provider configuration
# OPENAI_API_KEY is intentionally NOT here - use .env (not committed)
# ANTHROPIC_API_KEY is intentionally NOT here - use .env (not committed)

# Default model for agents (can be overridden per agent)
DEFAULT_MODEL=gpt-4

# Database configuration
DATABASE_URL=sqlite:///./baby.db

# Memory storage (can be extended to support other backends)
MEMORY_STORAGE_TYPE=sqlite

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info

# Security
ENABLE_APPROVAL_WORKFLOW=true

# Durable workers (separate processes; run `python -m baby.workers run`, or set WORKER_ENABLED=true
# to let the API supervise them). Stale timeout and lease duration must be >= 2 x heartbeat.
WORKER_ENABLED=false
WORKER_COUNT=1
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
WORKER_STALE_TIMEOUT_SECONDS=30.0
TASK_LEASE_DURATION_SECONDS=60.0
WORKER_SHUTDOWN_GRACE_SECONDS=10.0
WORKER_MAX_TASK_SECONDS=3600
